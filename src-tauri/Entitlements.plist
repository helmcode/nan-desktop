<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Microphone access for the push-to-talk speech-to-text (stt.rs).
         Required by hardened runtime (com.apple.security.device.audio-input)
         and by TCC (NSMicrophoneUsageDescription lives in Info.plist). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
